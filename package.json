{
  "name": "realkb",
  "version": "0.2.1",
  "description": "Local PDF knowledge bases for Pi with session-scoped connections, structure-aware chunking, hybrid sqlite-vec + FTS5 retrieval, and traceable page citations",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "knowledge-base",
    "pdf",
    "sqlite",
    "sqlite-vec",
    "embeddings",
    "citations"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "pi": {
    "extensions": [
      "./extensions/realkb/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "src",
    "extensions",
    "skills",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "bun test --timeout 60000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.624",
    "sqlite-vec": "^0.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.13.0",
    "typebox": "*",
    "typescript": "^5.8.2"
  }
}
